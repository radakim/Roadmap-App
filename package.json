{
  "name": "huawei-roadmap",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform ios",
    "test": "jest",
    "preweb": "node -e \"if (+process.versions.node.split('.')[0] < 20) { console.error('\\n  Node ' + process.version + ' is too old. Expo needs Node 20+.\\n  Run:  nvm use 22   (or once: nvm alias default 22)\\n'); process.exit(1); }\"",
    "web": "expo start --web",
    "prebuild:web": "node -e \"if (+process.versions.node.split('.')[0] < 20) { console.error('\\n  Node ' + process.version + ' is too old. Expo needs Node 20+.\\n  Run:  nvm use 22   (or once: nvm alias default 22)\\n'); process.exit(1); }\"",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.38",
    "expo-asset": "~12.0.14",
    "expo-clipboard": "~8.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setup.js"
    ]
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
